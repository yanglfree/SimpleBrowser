{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhuobrowser-auth-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "auth.zhuobrowser.youdroid.top",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "zhuobrowser-auth-db",
      "database_id": "61ea7a81-1d1b-48b2-9fcc-b0e2a03febeb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "zhuobrowser-avatars"
    },
    {
      "binding": "WALLPAPERS",
      "bucket_name": "zhuobrowser-wallpapers"
    },
    {
      "binding": "SYNC_BUNDLES",
      "bucket_name": "zhuobrowser-sync-bundles"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": [
      "10 16 * * *",
      "10 0 * * *"
    ]
  },
  "vars": {
    "APP_ID": "zhuobrowser-mac",
    "IAP_GATEWAY_URL": "https://gateway.youdroid.top",
    "OAUTH_REDIRECT_BASE": "https://auth.zhuobrowser.youdroid.top",
    "APPLE_CLIENT_IDS": "com.youdroid.zhuobrowser,com.youdroid.zhuobrowser.mac",
    "EMAIL_FROM": "noreply@auth-mail.youdroid.top",
    "EMAIL_FROM_NAME": "卓阅浏览器",
    "RESEND_FROM": "卓阅浏览器 <no-reply@youdroid.top>"
  }
}
